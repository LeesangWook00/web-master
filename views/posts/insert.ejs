<div class="my-5">
    <h1 class="text-center mb-5">글쓰기</h1>
    <div class="row justify-content-center">
        <div class="col-10 col-md-8 col-lg-6">
            <form name="frm">
                <div class="input-group mb-4 shadow-sm">
                    <span class="input-group-text bg-secondary-subtle text-secondary-emphasis fw-bold border-secondary-subtle" id="writer_label" style="width: 120px; justify-content: center;">작성자(ID)</span>
                    <input class="form-control bg-light text-secondary-emphasis border-secondary-subtle" name="writer" id="login_writer" readonly>
                </div>
                <div class="input-group mb-4 shadow-sm">
                    <span class="input-group-text bg-primary-subtle text-primary-emphasis fw-bold border-primary-subtle" style="width: 120px; justify-content: center;">제목</span>
                    <input class="form-control border-primary-subtle" name="title" placeholder="제목을 입력하세요." required>
                </div>
                <div class="input-group mb-4 shadow-sm">
                    <span class="input-group-text bg-info-subtle text-info-emphasis fw-bold border-info-subtle" style="width: 120px; justify-content: center;">글 내용</span>
                    <textarea class="form-control border-info-subtle" name="content" rows="6" placeholder="자유롭게 글을 남겨주세요." required></textarea>
                </div>
                <div class="text-center mt-3">
                    <button class="btn btn-primary px-5" type="submit">등록</button>
                    <button class="btn btn-secondary px-5" type="button" onclick="location.href='/posts'">취소</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // 로그인 상태 확인 및 학번 자동 입력
    const uid = sessionStorage.getItem("id");
    const urole = sessionStorage.getItem("role");
    if (uid) {
        $("#login_writer").val(uid);
        if (urole === 'professor') {
            $("#writer_label").text("교수번호");
        } else {
            $("#writer_label").text("학번");
        }
    } else {
        alert("로그인이 필요한 서비스입니다.");
        location.href = "/users/login";
    }

    $(frm).on("submit", function(e) {
        e.preventDefault();
        if (confirm("게시글을 등록하시겠습니까?")) {
            $.ajax({
                type: "post",
                url: "/posts/insert",
                data: $(frm).serialize(),
                success: function() {
                    alert("게시글 등록 완료!");
                    location.href = "/posts"; // 목록으로 돌아가기
                },
                error: function(err) {
                    // 500 에러 발생 시 백엔드에서 보낸 상세 원인 출력
                    alert("게시글 등록 실패!\n상세: " + (err.responseText || "서버 에러"));
                }
            });
        }
    });
</script>