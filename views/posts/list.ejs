<div class="my-5">
    <h1 class="text-center mb-5">게시글</h1>
    
    <div class="row mb-2">
        <form name="frm" class="col-8 col-md-4">
            <div class="input-group">
                <input name="word" class="form-control" placeholder="제목 또는 작성자 검색">
                <button class="btn btn-primary">검색</button>
            </div>
        </form>
        <div class="col-4 col-md-8 text-end">
            <button class="btn btn-primary px-5 btn-insert">글쓰기</button>
        </div>
    </div>
    
    <table class="table table-striped table-hover text-center align-middle">
        <thead>
            <tr>
                <th scope="col" width="10%">번호</th>
                <th scope="col" width="45%">제목</th>
                <th scope="col" width="25%">작성자</th>
                <th scope="col" width="20%">작성일</th>
            </tr>
        </thead>
        <tbody id="tbl" class="table-group-divider"></tbody>
    </table>
    
    <!-- 페이징 버튼 영역 -->
    <div class="text-center">
        <button class="btn btn-primary btn-sm px-3" id="prev">이전</button>
        <span id="page" class="mx-3"></span>
        <button class="btn btn-primary btn-sm px-3" id="next">다음</button>
    </div>
</div>

<script id="temp" type="text/x-handlebars-template">
    {{#each .}}
    <tr style="cursor: pointer;" onclick="location.href='/posts/{{ID}}'">
        <td>{{RNUM}}</td>
        <td class="text-start">{{TITLE}}</td>
        <td>{{SNAME}}({{WRITER}})</td>
        <td class="text-end">
            {{#if IS_MODIFIED}}<span class="text-danger fw-bold me-1" style="font-size: 0.8em;" title="수정된 게시글입니다">N</span>{{/if}}{{REG_DATE}}
        </td>
    </tr>
    {{/each}}
</script>

<script>
    let page=1;
    let size=5;
    let word=""; // 검색어 변수 추가

    getList();

    // 검색 폼 이벤트 (기존 코드 유지하며 추가)
    // 정확한 jQuery 선택자를 사용하여 폼 이벤트를 잡고, 새로고침을 방지합니다.
    $("form[name='frm']").on("submit", function(e){
        e.preventDefault();
        page=1; // 검색 시 항상 1페이지부터 보여주도록 초기화
        word=$("input[name='word']").val(); // 모든 브라우저 환경에서 안전하게 동작하도록 선택자 변경
        getList();
    });

    $(".btn-insert").on("click", function(){
        // 로그인 유무에 따라 로그인 체크 후 이동
        const uid = sessionStorage.getItem("id");
        if(uid){
            location.href='/posts/insert';
        }else{
            sessionStorage.setItem("target", "/posts/insert");
            location.href='/users/login';
        }
    });

    $("#next").on("click", function(){
        page++;
        getList();
    });

    $("#prev").on("click", function(){
        page--;
        getList();
    });

    function getList() {
        console.log(page, size);
        $.ajax({
            type: "get",
            url: "/posts/list.json",
            data:{page, size, word}, // 백엔드로 검색어(word) 파라미터 전달 추가
            success:function(data) {
                console.log(data);
                
                // 검색 결과가 없을 때 빈 화면 대신 안내 메시지 출력
                if (data.list.length === 0) {
                    $("#tbl").html('<tr><td colspan="4" class="text-center py-5">게시물이 없습니다.</td></tr>');
                } else {
                    const temp = Handlebars.compile($("#temp").html());
                    $("#tbl").html(temp(data.list));
                }
                
                const last = Math.ceil(data.total/size) || 1;
                $("#page").html(`${page}/${last}`);

                //1페이지에서 이전 버튼을 클릭한 경우
                if(page==1) $("#prev").attr("disabled", true); 
                else  $("#prev").attr("disabled", false);
                //마지막 페이지에서 다음 버튼을 클릭한 경우
                if(page==last) $("#next").attr("disabled", true); 
                else  $("#next").attr("disabled", false);
            },
            error:function(err){
                console.error("데이터 통신 에러:", err);
                // 서버에서 보낸 상세 에러 메시지를 경고창으로 출력하여 원인을 즉시 확인합니다.
                alert(err.responseJSON ? err.responseJSON.error : "게시물을 불러오는데 실패했습니다.");
            }
        });
    }
</script>