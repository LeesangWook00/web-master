<div class="my-5">
    <h1 class="text-center mb-5">내 정보 (교수)</h1>
    <div class="row justify-content-center">
        <div class="col-8 col-md-6 col-lg-5">
            <form name="frm">
                <div class="input-group mb-3">
                    <span class="input-group-text">교수번호</span>
                    <input class="form-control" name="pcode" id="pcode" readonly>
                </div>
                <div class="input-group mb-3">
                    <span class="input-group-text">이름</span>
                    <input class="form-control" name="pname" id="pname" readonly>
                </div>
                <div class="input-group mb-3">
                    <span class="input-group-text">학과</span>
                    <input class="form-control" name="dept" id="dept" readonly>
                </div>
                <div class="input-group mb-3">
                    <span class="input-group-text">임용일</span>
                    <input class="form-control" name="hiredate" id="hiredate" type="date" readonly>
                </div>
                <div class="input-group mb-3">
                    <span class="input-group-text">직급</span>
                    <input class="form-control" name="title" id="title" readonly>
                </div>
                <div class="input-group mb-3">
                    <span class="input-group-text">급여</span>
                    <input class="form-control" name="salary" id="salary" type="number" readonly>
                </div>
                
                <!-- 기본 버튼 그룹 -->
                <div class="text-center mt-3" id="btn-group">
                    <button class="btn btn-primary px-4" type="button" id="btn-edit" style="display:none;">수정</button>
                    <button class="btn btn-secondary px-4 mx-2" type="button" onclick="history.back()">뒤로가기</button>
                </div>
                
                <!-- 수정 중일 때 나타나는 버튼 그룹 -->
                <div class="text-center mt-3" id="btn-group-edit" style="display:none;">
                    <button class="btn btn-primary px-4" type="button" id="btn-save">저장</button>
                    <button class="btn btn-secondary px-4 mx-2" type="button" id="btn-cancel">취소</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const readPcode = "<%= pcode %>"; 
    let originalData = {};

    getRead();

    function getRead() {
        $.ajax({
            type: "get",
            url: `/haksa/pro/${readPcode}.json`,
            success: function(data) {
                const professor = Array.isArray(data) ? data[0] : data;
                
                if (!professor) {
                    alert("교수 정보를 불러오지 못했습니다.");
                    return;
                }

                originalData = professor;
                $("#pcode").val(professor.PCODE || professor.pcode || readPcode);
                $("#pname").val(professor.PNAME || professor.pname);
                $("#dept").val(professor.DEPT || professor.dept);
                $("#hiredate").val(professor.FDATE || professor.fdate);
                $("#title").val(professor.TITLE || professor.title);
                $("#salary").val(professor.SALARY || professor.salary);

                // 본인 계정일 때만 수정 버튼 노출
                const currentId = sessionStorage.getItem("id");
                const dbId = String(professor.PCODE || professor.pcode || readPcode);

                const isStringMatch = currentId && currentId.trim().toLowerCase() === dbId.trim().toLowerCase();
                const isNumberMatch = currentId && !isNaN(currentId) && !isNaN(dbId) && Number(currentId) === Number(dbId);

                if (isStringMatch || isNumberMatch) {
                    $("#btn-edit").show();
                }
            },
            error: function(err) {
                alert("데이터 로드 실패!\n상세: " + (err.responseJSON ? err.responseJSON.error : err.responseText));
            }
        });
    }

    $("#btn-edit").on("click", function() {
        $("#btn-group").hide();
        $("#btn-group-edit").show();
        $("#pname, #dept, #hiredate, #title, #salary").attr("readonly", false);
    });

    $("#btn-cancel").on("click", function() {
        $("#pname").val(originalData.PNAME || originalData.pname || "");
        $("#dept").val(originalData.DEPT || originalData.dept || "");
        $("#hiredate").val(originalData.FDATE || originalData.fdate || "");
        $("#title").val(originalData.TITLE || originalData.title || "");
        $("#salary").val(originalData.SALARY || originalData.salary || "");
        
        $("#pname, #dept, #hiredate, #title, #salary").attr("readonly", true);
        
        $("#btn-group").show();
        $("#btn-group-edit").hide();
    });

    $("#btn-save").on("click", function() {
        if(confirm("내 정보를 수정하시겠습니까?")) {
            $.ajax({
                type: "post",
                url: "/haksa/pro/update",
                data: {
                    pcode: $("#pcode").val(),
                    pname: $("#pname").val(),
                    dept: $("#dept").val(),
                    hiredate: $("#hiredate").val(),
                    title: $("#title").val(),
                    salary: $("#salary").val()
                },
                success: function() {
                    alert("정보 수정 완료!");
                    sessionStorage.setItem("name", $("#pname").val()); // 변경된 이름 세션에 갱신
                    location.reload();
                },
                error: function(err) {
                    alert("수정 실패!\n" + err.responseText);
                }
            });
        }
    });
</script>