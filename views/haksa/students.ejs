<div class="my-5">
    <h1 class="text-center">학생관리</h1>
    <div class="text-end mb-2">
        <button class="btn btn-primary px-5 btn-insert-stu">학생등록</button>
    </div>
    <table id="tbl_students" class="table table-striped table-hover text-center align-middle"></table>
    <script id="temp_students" type="text/x-handlebars-template">
        <thead>
            <tr>
                <th scope="col">학번</th>
                <th scope="col">이름</th>
                <th scope="col">학과</th>
                <th scope="col">생년월일</th>
                <th scope="col">지도교수</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody class="table-group-divider">
        {{#each .}}
        <tr>
            <th scope="row">{{SCODE}}</th><td>{{SNAME}}</td><td>{{DEPT}}</td>
            <td>{{FDATE}}</td><td>{{PNAME}}</td>
            <td class="text-end"><button class="btn btn-outline-danger btn-sm delete" scode="{{SCODE}}">삭제</button></td>
        </tr>
        {{/each}}
        </tbody>
    </script>
</div>
<script>
    getList();
    function getList() {
        $.ajax({
            type:"get",
            url:"/haksa/stu/list.json",
            success:function(data){
                console.log(data);
                const temp=Handlebars.compile($("#temp_students").html());
                $("#tbl_students").html(temp(data));
            },
            error:function(xhr){
                console.error(xhr.responseText);
                alert("데이터 로딩 실패! VS Code 하단의 터미널 창을 확인해 주세요.");
            }
        });
    }

    $(".btn-insert-stu").on("click", function(){
        const role = sessionStorage.getItem("role");
        if (role === 'professor') {
            location.href = '/haksa/stu/insert';
        } else if (role === 'student') {
            alert('교수님만 학생 등록이 가능합니다.');
        } else {
            alert('교수 계정으로 로그인이 필요합니다.');
            sessionStorage.setItem("target", "/haksa/stu/insert");
            location.href = '/users/login';
        }
    });

    $("#tbl_students").on("click", ".delete", function(){
        const scode=$(this).attr("scode");
        if(confirm(scode + "번 학생를 정말로 삭제하실래요?")){
            $.ajax({
                type:"post",
                url:"/haksa/stu/delete",
                data:{scode},
                success:function(data){
                    alert('삭제완료!');
                    location.href='/haksa/stu';
                },
                error:function(){
                    alert('삭제실패!');
                }
            });
        }
    });
</script>