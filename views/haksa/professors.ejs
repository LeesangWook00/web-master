<div class="my-5">
    <h1 class="text-center">교수관리</h1>
    <div class="text-end mb-2">
        <button class="btn btn-primary px-5 btn-insert-pro">교수등록</button>
    </div>
    <table id="tbl_professors" class="table table-striped table-hover text-center align-middle"></table>
    <script id="temp_professors" type="text/x-handlebars-template">
        <thead>
            <tr>
                <th scope="col">교수번호</th>
                <th scope="col">이름</th>
                <th scope="col">학과</th>
                <th scope="col">임용일</th>
                <th scope="col">급여</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody class="table-group-divider">
        {{#each .}}
        <tr>
            <th scope="row">{{PCODE}}</th><td>{{PNAME}}</td><td>{{DEPT}}</td>
            <td>{{FDATE}}</td><td>{{FSALARY}}</td>
            <td class="text-end"><button class="btn btn-outline-danger btn-sm delete" pcode="{{PCODE}}">삭제</button></td>
        </tr>
        {{/each}}
        </tbody>
    </script>
</div>
<script>
    getList();
    function getList() {
        $.ajax({
            type:"get",
            url:"/haksa/pro/list.json",
            success:function(data){
                console.log(data);
                const temp=Handlebars.compile($("#temp_professors").html());
                $("#tbl_professors").html(temp(data));
            }
        });
    }

    $(".btn-insert-pro").on("click", function(){
        const role = sessionStorage.getItem("role");
        if (role === 'professor') {
            location.href = '/haksa/pro/insert';
        } else if (role === 'student') {
            alert('교수님만 교수 등록이 가능합니다.');
        } else {
            alert('교수 계정으로 로그인이 필요합니다.');
            sessionStorage.setItem("target", "/haksa/pro/insert");
            location.href = '/users/login';
        }
    });

    $("#tbl_professors").on("click", ".delete", function(){
        const pcode = $(this).attr("pcode");
        if(confirm(pcode + "번 교수를 정말로 삭제하실래요?")){
            $.ajax({
                type:"post",
                url:"/haksa/pro/delete",
                data:{pcode},
                success:function(data){
                    alert('삭제완료!');
                    location.href='/haksa/pro';
                },
                error:function(){
                    alert('삭제실패!');
                }
            });
        }
    });
</script>